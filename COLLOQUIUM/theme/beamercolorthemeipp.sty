\RequirePackage{theme/beamercolors}

\setbeamercolor{section in head/foot}{parent=palette quaternary}
\setbeamercolor{subsection in head/foot}{parent=palette primary}
\setbeamercolor{author in head/foot}{parent=section in head/foot}
\setbeamercolor{title in head/foot}{parent=subsection in head/foot}
\setbeamercolor{frametitle}{parent=subsection in head/foot}
\setbeamercolor{frametitle right}{parent=section in head/foot}
\setbeamercolor{footlinecolor}{bg=ipplight,fg=ipp}

\setbeamercolor{itemize item}{fg=ippdark, bg=}
\setbeamercolor{itemize subitem}{fg=ippalt, bg=}
\setbeamercolor{itemize subsubitem}{fg=ippdark, bg=}

\setbeamercolor{enumerate item}{fg=ippdark, bg=}
\setbeamercolor{enumerate subitem}{fg=ippalt, bg=}
\setbeamercolor{enumerate subsubitem}{fg=ippdark, bg=}

\setbeamercolor{itemize/enumerate subbody}{fg=ippalt}
\setbeamercolor{itemize/enumerate subsubbody}{fg=ippdark}

\setbeamercolor*{structure}{fg=ipp}
\setbeamercolor*{block title}{fg=white, bg=ipp}
\setbeamercolor*{block body}{fg=black, bg=ipplight}
\setbeamercolor*{frametitle}{fg=ipp}
\setbeamercolor*{title in head/foot}{bg=ipplight,fg=black}
\setbeamercolor*{section in toc}{fg=ipp}

\setbeamerfont*{frametitle}{series=\bfseries,size=\large,parent=structure}
